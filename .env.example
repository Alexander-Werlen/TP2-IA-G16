# ── OpenCode GO (LLM chat) ───────────────────────────────
OPENCODE_GO_API_KEY=sk-opencode-go-api-key
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1   # (default)

# ── Google Gemini (solo embeddings) ──────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# ── Modelos LLM ──────────────────────────────────────────
ALLOWED_MODELS=deepseek-v4-flash,glm-5.2
DEFAULT_MODEL=deepseek-v4-flash
PERCEIVE_MODEL=deepseek-v4-flash
SUMMARY_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── Base de datos ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/tutoria.db

# ── ChromaDB ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# ── App ────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Uploads (Fase 4) ──────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520
